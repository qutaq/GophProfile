APP_ENV=development
APP_NAME=gophprofile

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

DB_HOST=localhost
DB_PORT=5432
DB_USER=gophprofile
DB_PASSWORD=gophprofile
DB_NAME=gophprofile
DB_SSLMODE=disable

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_USE_SSL=false
S3_REGION=us-east-1

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=avatars.exchange

UPLOAD_MAX_SIZE_BYTES=10485760

# For the worker process use OTEL_SERVICE_NAME=gophprofile-worker
OTEL_ENABLED=true
OTEL_SERVICE_NAME=gophprofile-server
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
LOG_LEVEL=info
METRICS_PATH=/metrics
METRICS_ADDR=:9091
